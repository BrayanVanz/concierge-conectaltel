# --- Credenciais AWS (ou use `aws configure` / SSO em vez destas) ---
# Necessárias só para a chamada ao Bedrock (geração dos vetores).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Módulo de embeddings (src/embeddings/main.py) ---
# Ambas opcionais. Sem definir nada, o main.py processa TODOS os .jsonl de
# data/chunks/ e grava a saída em data/embeddings/. Defina só para rodar 1 arquivo:
# EMBEDDINGS_INPUT_PATH=data/chunks/chunks_hierarchical_semantic.jsonl
# EMBEDDINGS_OUTPUT_PATH=data/embeddings/chunks_hierarchical_semantic_embedded.jsonl
